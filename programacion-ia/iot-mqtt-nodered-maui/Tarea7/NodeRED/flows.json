[
    {
        "id": "flow_iot_1",
        "type": "tab",
        "label": "Control Luces IoT",
        "disabled": false,
        "info": "Recibe JSON por HTTP con el estado de 3 LEDs y lo publica en MQTT"
    },
    {
        "id": "http_in_encender",
        "type": "http in",
        "z": "flow_iot_1",
        "name": "POST /encender",
        "url": "/encender",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 130,
        "y": 200,
        "wires": [
            ["function_process", "http_response"]
        ]
    },
    {
        "id": "function_process",
        "type": "function",
        "z": "flow_iot_1",
        "name": "Preparar JSON MQTT",
        "func": "// Pasa el payload entero como string JSON al MQTT\n// El ESP32 espera: {\"verde\":\"on\",\"roja\":\"off\",\"azul\":\"blink\"}\nmsg.payload = JSON.stringify(msg.payload);\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 200,
        "wires": [
            ["mqtt_out", "debug_node"]
        ]
    },
    {
        "id": "mqtt_out",
        "type": "mqtt out",
        "z": "flow_iot_1",
        "name": "Publicar MQTT",
        "topic": "iabd2425/esp32/led",
        "qos": "0",
        "retain": "",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "mqtt_broker_config",
        "x": 590,
        "y": 160,
        "wires": []
    },
    {
        "id": "http_response",
        "type": "http response",
        "z": "flow_iot_1",
        "name": "Respuesta HTTP",
        "statusCode": "200",
        "headers": {},
        "x": 380,
        "y": 320,
        "wires": []
    },
    {
        "id": "debug_node",
        "type": "debug",
        "z": "flow_iot_1",
        "name": "Debug comando",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload",
        "statusType": "auto",
        "x": 600,
        "y": 240,
        "wires": []
    },
    {
        "id": "mqtt_broker_config",
        "type": "mqtt-broker",
        "name": "Mosquitto Publico",
        "broker": "test.mosquitto.org",
        "port": "1883",
        "clientid": "",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "autoUnsubscribe": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "willMsg": {},
        "userProps": "",
        "sessionExpiry": ""
    }
]
