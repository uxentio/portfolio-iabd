# =============================================================================
# Proveedor del LLM
# -----------------------------------------------------------------------------
# El proyecto habla con cualquier endpoint compatible con la API de OpenAI
# (`/v1/chat/completions`). Para cambiar de proveedor basta con descomentar
# uno de los bloques de abajo y dejar los otros comentados, y reiniciar la
# API (`uvicorn`) para que recargue el .env.
#
# El selector de modelos del cliente MAUI (Settings → Modelo) cambia el
# modelo DENTRO del proveedor activo, no el proveedor en sí: se rellena con
# `GET /v1/models` contra `OPENAI_BASE_URL`. Para saltar de LM Studio a Groq
# (o viceversa) hay que tocar este archivo y reiniciar `uvicorn`.
# =============================================================================

# --- Opción A: LM Studio (local, gratis, offline) ---
# Carga un modelo con Tool use marcado en sus Capabilities. Recomendado
# Qwen2.5-7B-Instruct-1M (Q4_K_M). En hardware modesto cada turno tarda
# 90-130 s; con GPU de 8 GB+ baja a 1-3 s.
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_MODEL=qwen2.5-7b-instruct-1m
OPENAI_API_KEY=lm-studio

# --- Opción B: Groq (remoto, gratis con rate limits, muy rápido) ---
# Tier gratuito generoso (30 req/min, 14.400 req/día en llama-3.3-70b).
# Velocidad típica: 250-800 tok/s (turno completo en 1-2 s). Alta en
# https://console.groq.com — no pide tarjeta. Tool calling soportado.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Opción C: OpenRouter (aggregator, modelos `:free` disponibles) ---
# Agrupa decenas de proveedores con la misma API. Útil para probar varios
# modelos sin abrir cuenta en cada uno. Alta en https://openrouter.ai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# --- Opción D: OpenAI (de pago, baratísimo en gpt-4o-mini) ---
# ~$0.15/1M tokens entrada, $0.60/1M salida. Una sesión de pruebas son
# céntimos. Requiere tarjeta y carga mínima de $5.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Resto de configuración del proyecto
# =============================================================================

# Formulario local que rellena el runner.
FORM_URL=http://localhost:8080/index.html

# Backend del agente. Valores soportados:
#   langgraph (default) -> StateGraph propio con HITL
#   langchain           -> create_agent con middlewares
AGENT_BACKEND=langgraph

# Cierre del navegador cuando el RPA termina, solo en modo visible.
# Por defecto se queda abierto y espera a que pulses Enter en consola.
# Si prefieres tiempos finitos: pon ms (p.ej. 5000) o 0 para cerrar al vuelo.
# RPA_VIEW_DELAY_MS=keep

# Ralentizado por acción (clicks, fills, selects) en modo visible. Default 400 ms.
# Sube si quieres que se vea más lento en la grabación, baja a 0 para velocidad
# máxima. En modo headless siempre es 0.
# RPA_SLOW_MO_MS=400

# Grabación con Playwright (opt-in, off por defecto).
# Tracing: arranca al abrir el navegador y guarda un .zip con DOM, screenshots,
# network y consola SOLO si la cadena falla. Sin coste si todo va bien (el
# trace se descarta). Visualiza con: playwright show-trace <ruta>
# RPA_TRACE_ON_ERROR=1
#
# Vídeo: graba toda la sesión del navegador en data/videos/*.webm. Útil como
# material para grabaciones de demo sin necesidad de capturar pantalla con
# OBS. Pesa más que el tracing y siempre genera archivo, también si va bien.
# RPA_RECORD_VIDEO=1
