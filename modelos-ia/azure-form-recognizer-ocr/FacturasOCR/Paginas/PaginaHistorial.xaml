<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modelos="clr-namespace:FacturasOCR.Modelos"
             x:Class="FacturasOCR.Paginas.PaginaHistorial"
             Title="Archivo">

    <Grid RowDefinitions="Auto,Auto,*" Padding="15" RowSpacing="10">

        <!-- Cabecera -->
        <HorizontalStackLayout Spacing="10">
            <Label x:Name="lblHeader" Text="Archivo de facturas"
                   FontSize="20"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            <Label x:Name="lblCount"
                   FontSize="14"
                   TextColor="Gray"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Info de almacenamiento -->
        <VerticalStackLayout Grid.Row="1" Spacing="2">
            <Label x:Name="lblHint"
                   Text="Toca una factura para ver los detalles."
                   FontSize="11"
                   TextColor="#9CA3AF" />
            <Label x:Name="lblDbPath"
                   FontSize="10"
                   TextColor="#6B7280"
                   LineBreakMode="TailTruncation" />
        </VerticalStackLayout>

        <!-- Lista de resultados guardados -->
        <CollectionView x:Name="collectionResults"
                        Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="OnResultSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="modelos:ResultadoFactura">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Eliminar"
                                           BackgroundColor="#DC2626"
                                           Invoked="OnDeleteSwipe"
                                           BindingContext="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Stroke="#4B5563"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="12"
                                Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Label Text="{Binding FileName}"
                                       FontSize="15"
                                       FontAttributes="Bold" />
                                <Label Grid.Row="1"
                                       Text="{Binding AnalyzedAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                       FontSize="12"
                                       TextColor="#9CA3AF" />
                                <Label Grid.Row="2"
                                       Text="{Binding VendorName}"
                                       FontSize="13"
                                       TextColor="#6B7280" />
                                <Label Grid.Column="1"
                                       Grid.RowSpan="3"
                                       Text="{Binding Total}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#34D399"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0" />
                                <Button Grid.Column="2"
                                        Grid.RowSpan="3"
                                        Text="&#x1f5d1;"
                                        FontSize="16"
                                        BackgroundColor="Transparent"
                                        TextColor="#DC2626"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        VerticalOptions="Center"
                                        Clicked="OnDeleteButtonClicked"
                                        BindingContext="{Binding .}" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="10">
                    <Label x:Name="lblEmptyTitle" Text="No hay facturas guardadas"
                           FontSize="16"
                           HorizontalOptions="Center"
                           TextColor="Gray" />
                    <Label x:Name="lblEmptyHint"
                           Text="Ve a la pestaña 'Analizar' y procesa una factura."
                           FontSize="13"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>

</ContentPage>
