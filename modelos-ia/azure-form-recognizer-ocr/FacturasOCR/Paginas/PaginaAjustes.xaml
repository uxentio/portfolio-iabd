<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FacturasOCR.Paginas.PaginaAjustes"
             Title="Ajustes">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- === AZURE DOCUMENT INTELLIGENCE === -->
            <Label x:Name="lblAzureTitle" Text="Azure Document Intelligence"
                   FontSize="18"
                   FontAttributes="Bold" />
            <Label x:Name="lblAzureDesc"
                   Text="Datos del recurso Azure para el OCR."
                   FontSize="12"
                   TextColor="#9CA3AF" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Endpoint" FontSize="13" FontAttributes="Bold" />
                <Entry x:Name="entryEndpoint"
                       Placeholder="https://tu-recurso.cognitiveservices.azure.com/"
                       Keyboard="Url" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label x:Name="lblApiKeyLabel" Text="Clave API (API Key)" FontSize="13" FontAttributes="Bold" />
                <Entry x:Name="entryApiKey"
                       Placeholder="Tu clave de Azure"
                       IsPassword="True" />
                <Label x:Name="lblSavedLocally" Text="Se guarda de forma local en el dispositivo."
                       FontSize="10"
                       TextColor="#6B7280" />
            </VerticalStackLayout>

            <Label x:Name="lblModelInfo"
                   Text="Modelo: prebuilt-invoice"
                   FontSize="11"
                   TextColor="#6B7280" />

            <HorizontalStackLayout Spacing="10">
                <Button x:Name="btnSaveAzure" Text="Guardar Azure"
                        Clicked="OnSaveClicked"
                        BackgroundColor="#512BD4"
                        TextColor="White" />
                <Button x:Name="btnTest" Text="Probar conexion"
                        Clicked="OnTestClicked"
                        BackgroundColor="#2563EB"
                        TextColor="White" />
                <Button x:Name="btnReset" Text="Restaurar valores"
                        Clicked="OnResetClicked"
                        BackgroundColor="#6B7280"
                        TextColor="White" />
            </HorizontalStackLayout>

            <Label x:Name="lblTestResult"
                   FontSize="13"
                   TextColor="#9CA3AF" />

            <!-- === APARIENCIA === -->
            <BoxView HeightRequest="1" Color="#374151" Margin="0,5" />

            <Label x:Name="lblThemeTitle" Text="Apariencia"
                   FontSize="18"
                   FontAttributes="Bold" />
            <Label x:Name="lblThemeDesc"
                   Text="Elige el tema visual de la aplicacion."
                   FontSize="12"
                   TextColor="#9CA3AF" />
            <Picker x:Name="pickerTheme"
                    SelectedIndexChanged="OnThemeChanged" />

            <!-- === ALMACENAMIENTO === -->
            <BoxView HeightRequest="1" Color="#374151" Margin="0,5" />

            <Label x:Name="lblStorageTitle" Text="Almacenamiento"
                   FontSize="18"
                   FontAttributes="Bold" />
            <Label x:Name="lblStorageDesc"
                   Text="Carpeta donde se guardan la base de datos y las copias de las facturas."
                   FontSize="12"
                   TextColor="#9CA3AF" />

            <VerticalStackLayout Spacing="4">
                <Label x:Name="lblDataFolder" Text="Carpeta de datos" FontSize="13" FontAttributes="Bold" />
                <Entry x:Name="entryDbDirectory"
                       Placeholder="Ruta de la carpeta" />
                <Label x:Name="lblDbImagesInfo"
                       Text="Aqui se guardaran invoices.db y la carpeta images/ con las facturas."
                       FontSize="10"
                       TextColor="#6B7280" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Button x:Name="btnPickFolder" Text="Elegir carpeta"
                        Clicked="OnPickFolderClicked"
                        BackgroundColor="#374151"
                        TextColor="White" />
                <Button x:Name="btnSavePath" Text="Guardar ruta"
                        Clicked="OnSaveStorageClicked"
                        BackgroundColor="#512BD4"
                        TextColor="White" />
                <Button x:Name="btnRestoreStorage" Text="Restaurar"
                        Clicked="OnResetStorageClicked"
                        BackgroundColor="#6B7280"
                        TextColor="White" />
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label x:Name="lblCurrentDb" Text="Base de datos actual:" FontSize="12" TextColor="#9CA3AF" />
                <Label x:Name="lblDbPath" FontSize="11" TextColor="#6B7280" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label x:Name="lblCurrentFiles" Text="Carpeta de facturas actual:" FontSize="12" TextColor="#9CA3AF" />
                <Label x:Name="lblFilesPath" FontSize="11" TextColor="#6B7280" />
            </VerticalStackLayout>

            <Button x:Name="btnOpenFolder" Text="Abrir carpeta de datos"
                    Clicked="OnOpenFolderClicked"
                    BackgroundColor="#374151"
                    TextColor="White" />

            <!-- === COPIA DE SEGURIDAD === -->
            <BoxView HeightRequest="1" Color="#374151" Margin="0,5" />

            <Label x:Name="lblBackupTitle" Text="Copia de seguridad"
                   FontSize="18"
                   FontAttributes="Bold" />
            <Label x:Name="lblBackupDesc"
                   Text="Copia automatica de las facturas a otra carpeta (OneDrive, Google Drive, Dropbox...)."
                   FontSize="12"
                   TextColor="#9CA3AF" />

            <HorizontalStackLayout Spacing="10">
                <Label x:Name="lblBackupEnabled" Text="Activar copia de seguridad"
                       FontSize="13" VerticalOptions="Center" />
                <Switch x:Name="switchBackup" />
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label x:Name="lblBackupFolder" Text="Carpeta de copia" FontSize="13" FontAttributes="Bold" />
                <Entry x:Name="entryBackupFolder"
                       Placeholder="Ej: C:\Users\tu_usuario\OneDrive\Facturas" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Button x:Name="btnPickBackup" Text="Elegir carpeta"
                        Clicked="OnPickBackupFolderClicked"
                        BackgroundColor="#374151"
                        TextColor="White" />
                <Button x:Name="btnSaveBackup" Text="Guardar copia de seguridad"
                        Clicked="OnSaveBackupClicked"
                        BackgroundColor="#512BD4"
                        TextColor="White" />
            </HorizontalStackLayout>

            <!-- === IDIOMA (al final) === -->
            <BoxView HeightRequest="1" Color="#374151" Margin="0,5" />

            <Label x:Name="lblLanguageTitle" Text="Idioma"
                   FontSize="18"
                   FontAttributes="Bold" />
            <Label x:Name="lblLanguageDesc" Text="Cambia el idioma de la interfaz."
                   FontSize="12"
                   TextColor="#9CA3AF" />
            <Picker x:Name="pickerLanguage"
                    SelectedIndexChanged="OnLanguageChanged" />

            <!-- Version -->
            <Label Text="FacturasOCR v1.0 - Tarea 7 Azure"
                   FontSize="11"
                   TextColor="#4B5563"
                   Margin="0,10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
