<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modelos="clr-namespace:MauiRAG.Modelos"
             xmlns:vm="clr-namespace:MauiRAG.ViewModels"
             x:Class="MauiRAG.MainPage"
             x:Name="thisPage"
             x:DataType="vm:ChatViewModel"
             Title="Chat RAG">

    <Grid Padding="15" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">

        <!-- fila 0: seleccion de workspace -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Workspace:" VerticalOptions="Center" FontSize="16"/>
            <Picker x:Name="pickerWorkspace" Title="Selecciona workspace" WidthRequest="200"
                    ItemsSource="{Binding NombresWorkspaces}"
                    SelectedIndex="{Binding WorkspaceSeleccionado}"/>
            <Button Text="Limpiar Chat" Command="{Binding LimpiarCommand}" FontSize="12"/>
        </HorizontalStackLayout>

        <!-- fila 1: modo chat o query -->
        <HorizontalStackLayout Grid.Row="1" Spacing="15">
            <Label Text="Modo:" VerticalOptions="Center"/>
            <RadioButton x:Name="rbChat" Content="Chat" IsChecked="{Binding ModoChat}" GroupName="Modo"/>
            <RadioButton x:Name="rbQuery" Content="Query" GroupName="Modo"/>
        </HorizontalStackLayout>

        <!-- fila 2: mensajes del chat con binding al viewmodel -->
        <Grid Grid.Row="2">
            <CollectionView x:Name="listaMensajes" ItemsSource="{Binding Mensajes}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="modelos:MensajeChat">
                        <Border BackgroundColor="{Binding ColorFondo}" Stroke="Transparent"
                                StrokeShape="RoundRectangle 12" Padding="10"
                                Margin="{Binding Margen}">
                            <VerticalStackLayout>
                                <Label Text="{Binding Remitente}" FontSize="11"
                                       FontAttributes="Bold" TextColor="Gray"/>
                                <Label Text="{Binding Texto}" FontSize="14" TextColor="Black"/>
                                <Label Text="{Binding Hora}" FontSize="10" TextColor="Gray"
                                       HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <ActivityIndicator IsRunning="{Binding Enviando}" IsVisible="{Binding Enviando}"
                               Color="#512BD4" VerticalOptions="Center" HorizontalOptions="Center"
                               WidthRequest="50" HeightRequest="50"/>
        </Grid>

        <!-- fila 3: chunks / trazabilidad con handle para redimensionar -->
        <VerticalStackLayout Grid.Row="3" Spacing="0">
            <BoxView x:Name="handleTrazabilidad" HeightRequest="8" BackgroundColor="#512BD4"
                     CornerRadius="4" Margin="100,0,100,2" Opacity="0.6"/>
            <Border x:Name="frameTrazabilidad" Padding="10" StrokeShape="RoundRectangle 8"
                    Stroke="#512BD4" BackgroundColor="#1A1A2E" HeightRequest="180"
                    MinimumHeightRequest="80">
                <ScrollView VerticalScrollBarVisibility="Always">
                    <VerticalStackLayout>
                        <Label Text="Trazabilidad (chunks recuperados):" FontSize="13"
                               FontAttributes="Bold" TextColor="White" Margin="0,0,0,5"/>
                        <CollectionView ItemsSource="{Binding Chunks}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="modelos:ChunkInfo">
                                    <Border Padding="8" StrokeShape="RoundRectangle 6" Margin="0,2"
                                            BackgroundColor="{Binding ColorFondo}"
                                            Stroke="{Binding ColorBorde}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnChunkTapped"/>
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding TituloDisplay}" FontSize="12"
                                                   FontAttributes="Bold" TextColor="#E0E0FF"/>
                                            <Label Text="{Binding TextoMostrado}" FontSize="11"
                                                   TextColor="#BBBBCC"/>
                                            <Label Text="{Binding ScoreDisplay}" FontSize="11"
                                                   TextColor="#66BBFF" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </VerticalStackLayout>

        <!-- fila 4: entrada de texto y boton enviar -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Entry x:Name="txtPregunta" Placeholder="Escribe tu pregunta aqui..."
                   Grid.Column="0" FontSize="14" Text="{Binding Pregunta}"
                   Completed="btnEnviar_Click"/>
            <Button Text="{Binding TextoBotonEnviar}" Grid.Column="1"
                    Command="{Binding EnviarCommand}"
                    BackgroundColor="#512BD4" TextColor="White"/>
        </Grid>

    </Grid>

</ContentPage>
