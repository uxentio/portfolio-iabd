<Window x:Class="AnythingLLM_RAG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnythingLLM_RAG"
        mc:Ignorable="d"
        Title="AnythingLLM RAG" Height="600" Width="800">
    <Grid Margin="10">
        <!-- Área para subir documento -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,10">
            <Button x:Name="btnUpload" Content="Subir Documento" Width="150" Margin="0,0,10,0" Click="btnUpload_Click"/>
            <TextBox x:Name="txtStatus" VerticalAlignment="Center" FontWeight="Bold" TextWrapping="Wrap" Width="Auto"/>
        </StackPanel>

        <!-- Área principal -->
        <Grid Margin="0,50,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Selección de modo -->
                <RowDefinition Height="Auto"/>
                <!-- Pregunta -->
                <RowDefinition Height="Auto"/>
                <!-- Botón de pregunta -->
                <RowDefinition Height="*"/>
                <!-- Respuesta -->
                <RowDefinition Height="Auto"/>
                <!-- Chunks -->
                <RowDefinition Height="Auto"/>
                <!-- Botones para ver documentos -->
                <RowDefinition Height="2*"/>
                <!-- Documentos del workspace -->
            </Grid.RowDefinitions>

            <!-- Selección de modo de consulta -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="Modo:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <RadioButton x:Name="rbChat" Content="Chat" IsChecked="True" GroupName="QueryMode"/>
                <RadioButton x:Name="rbQuery" Content="Query" Margin="10,0,0,0" GroupName="QueryMode"/>
            </StackPanel>

            <!-- Caja de texto para la pregunta -->
            <TextBox x:Name="txtQuestion" Grid.Row="1" Height="30" FontSize="14" Margin="0,0,0,10"
                     ToolTip="Escribe tu pregunta aquí"/>

            <!-- Botón para enviar la pregunta -->
            <Button x:Name="btnAsk" Content="Hacer Pregunta" Grid.Row="2" Width="150" Height="30" Margin="0,0,0,10" Click="btnAsk_Click"/>

            <!-- Área para mostrar la respuesta principal -->
            <TextBox x:Name="txtAnswer" Grid.Row="3" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" 
                     FontSize="14" TextWrapping="Wrap" IsReadOnly="True" Height="100"/>

            <!-- TextBox para mostrar la información de los chunks -->
            <TextBox x:Name="txtChunks" Grid.Row="4" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                     FontSize="14" TextWrapping="Wrap" IsReadOnly="True" Margin="0,10,0,0" Height="100"/>

            <!-- Botones para obtener documentos -->
            <StackPanel Orientation="Horizontal" Grid.Row="5" HorizontalAlignment="Center" Margin="0,10,0,10">
                <Button x:Name="btnGetDocuments" Content="Ver Documentos" Width="150" Margin="0,0,10,0" Click="btnGetDocuments_Click"/>
                <Button x:Name="btnGetDocumentsSlug" Content="Ver Documentos Slug" Width="180" Click="btnGetDocumentsSlug_Click"/>
            </StackPanel>

            <!-- TextBox para mostrar los documentos del workspace -->
            <TextBox x:Name="txtWorkspaceDocs" Grid.Row="6" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                     FontSize="14" TextWrapping="Wrap" IsReadOnly="True" Margin="0,10,0,0" Height="100"/>
        </Grid>
    </Grid>
</Window>
